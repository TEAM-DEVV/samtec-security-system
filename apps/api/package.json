{
  "name": "@samtec/api",
  "version": "0.1.0",
  "private": true,
  "description": "SAMTEC backend: NestJS REST API with PostgreSQL through Prisma.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/dev-database.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset && prisma db seed",
    "db:studio": "prisma studio",
    "account:admin": "tsx scripts/admin-account.ts",
    "mock:devices": "tsx scripts/mock-devices.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.2",
    "@nestjs/core": "^12.0.2",
    "@nestjs/platform-express": "^12.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.2",
    "@samtec/contracts": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.0",
    "@types/supertest": "^7.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "7.9.1",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0"
  }
}
