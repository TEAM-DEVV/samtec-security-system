# Copy this file to `.env` in the same folder (apps/api/.env), then adjust it.
# `.env` is ignored by git. Never commit real passwords or keys.

# development | test | production
NODE_ENV=development

# The port the API listens on
PORT=3000

# PostgreSQL connection string.
# This value matches the local database started by `pnpm db:start`.
# For Supabase, paste the connection string from the Supabase dashboard instead.
DATABASE_URL=postgresql://samtec:samtec-local-only@localhost:54329/samtec_dev

# Websites allowed to call the API from a browser, separated by commas. This
# is the dashboard: signing in from here keeps you signed in (a refresh cookie).
CORS_ORIGINS=http://localhost:5173

# Where the kiosk app is served from, separated by commas (docs/plan/13
# section 2). A sign-in from one of these gets no refresh cookie and a token
# that only works on the kiosk screens. Leave it out until a kiosk is
# deployed; an address can never be in both lists, or the API refuses to start.
# Keep them all on ONE host: fingerprint keys belong to the first address's
# host, and a browser on a different host cannot make one (docs/plan/13 §4).
# KIOSK_ORIGINS=http://localhost:5174

# The one secret behind sign-in (access tokens and encrypted authenticator
# secrets are derived from it). Leaving it out uses a built-in development
# value, which is fine on your own computer. Production requires a real one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=paste-your-own-random-value-here

# Which biometric provider attendance uses. Only "mock" exists until Phase 3
# adds the real ones (docs/plan/10-biometric-integration.md).
# BIOMETRIC_PROVIDER=mock

# Whether simulator (MOCK) devices may send punches: "yes" or "no". When it is
# left out, simulators work in development and are refused when
# NODE_ENV=production.
# The TEST environment runs in production mode and sets "yes" for its
# attendance demo; a client's production never does.
# ALLOW_SIMULATOR_DEVICES=yes
