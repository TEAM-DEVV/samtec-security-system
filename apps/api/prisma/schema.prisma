// =============================================================================
// SAMTEC database schema (PostgreSQL, managed with Prisma)
// -----------------------------------------------------------------------------
// This file describes every table. After changing it, run `pnpm db:migrate` to
// create a migration: a SQL file that updates the real database.
// The rules behind these tables live in docs/plan/04-data-model.md.
//
// Naming: TypeScript uses camelCase (firstName). `@map` and `@@map` store the
// same names in snake_case (first_name), the usual PostgreSQL convention, so
// hand-written SQL in later phases stays readable.
//
// Every migration that creates a table must also enable row-level security on
// it (see the end of the first migration and docs/plan/04-data-model.md).
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Where an employee is in their working life. Mirrors `EmployeeStatus` in the API contract.
enum EmployeeStatus {
  PENDING_ENROLLMENT
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// Why an employee left. Mirrors `TerminationReason` in the API contract.
enum TerminationReason {
  RESIGNED
  DISMISSED
  CONTRACT_ENDED
  ABSCONDED
  DECEASED
  OTHER
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

/// ACTIVE means the client pays for this post; INACTIVE keeps it for history.
enum PostStatus {
  ACTIVE
  INACTIVE
}

/// What a user account is allowed to do. Mirrors `UserRole` in the API contract.
enum UserRole {
  ADMIN
  HR_PAYROLL
  SUPERVISOR
  GUARD
}

/// Why a sign-in challenge token was issued (see the `auth_challenges` table).
enum AuthChallengePurpose {
  /// The user typed the right password and must now enter a two-factor code.
  VERIFY_CODE
  /// The user typed the right password and must now set up two-factor authentication.
  SET_UP
}

/// The 16 administrative regions of Ghana.
enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

/// The security company using SAMTEC. Version 1 has exactly one company, but
/// every business table stores `companyId` so more companies can be added later.
model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees   Employee[]
  sites       Site[]
  assignments SiteAssignment[]
  users       User[]
  auditLogs   AuditLog[]
  periods     EmploymentPeriod[]
  posts       Post[]
  shiftPatterns ShiftPattern[]

  @@map("companies")
}

/// Someone who can sign in to the dashboard. Owned by the identity module.
/// A user may be linked to an employee record (guards and supervisors), or
/// stand alone (office-only accounts).
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// Stored lower-case, so sign-in is not case-sensitive.
  email        String
  /// A scrypt hash. The password itself is never stored (see modules/identity/password.ts).
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  /// A disabled account cannot sign in, and its refresh tokens stop working.
  isActive     Boolean  @default(true) @map("is_active")
  /// The employee this account belongs to, or null for office-only accounts.
  employeeId   String?  @unique @map("employee_id") @db.Uuid

  /// The authenticator-app secret, encrypted with AES-256-GCM (never stored as
  /// plain text). Null until the user finishes two-factor setup.
  twoFactorSecretEncrypted String?   @map("two_factor_secret_encrypted")
  twoFactorEnabledAt       DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  /// The time step of the last accepted code. A code for this step or earlier
  /// is refused, so an overheard code cannot be replayed.
  twoFactorLastUsedStep    BigInt?   @map("two_factor_last_used_step")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessions   UserSession[]
  challenges AuthChallenge[]

  @@unique([companyId, email])
  @@map("users")
}

/// One signed-in browser: the record behind a refresh token cookie.
/// Owned by the identity module.
///
/// Rotation: every use of a refresh token revokes this row and creates a new
/// one (`replacedById` points forward). If a token arrives for a row that was
/// already replaced, someone copied it, and every session of that user is revoked.
model UserSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the refresh token. The token itself only exists in the cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// The session that replaced this one when the token was rotated.
  replacedById String? @map("replaced_by_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_sessions")
}

/// A half-finished sign-in: the password was right, but a two-factor step is
/// still needed. Owned by the identity module. Rows expire within minutes and
/// are deleted once used.
model AuthChallenge {
  id      String               @id @default(uuid(7)) @db.Uuid
  userId  String               @map("user_id") @db.Uuid
  purpose AuthChallengePurpose
  /// SHA-256 of the challenge or setup token sent to the browser.
  tokenHash String @unique @map("token_hash")
  /// For SET_UP: the new authenticator secret (encrypted), moved to the user
  /// only after they prove their app works by entering a correct code.
  pendingSecretEncrypted String? @map("pending_secret_encrypted")
  /// Wrong codes entered so far. At 5 the challenge is cancelled.
  failedAttempts Int      @default(0) @map("failed_attempts")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_challenges")
}

/// Counts failed sign-in steps — wrong passwords per email, wrong two-factor
/// codes per account — so guessing gets locked out. Rows are written with one
/// atomic SQL statement (see SignInThrottleService), so parallel attempts
/// cannot slip past the counter.
model SignInThrottle {
  /// An HMAC (keyed with a key derived from AUTH_SECRET) of what is being
  /// throttled, for example `password:<email>` or `totp:<user id>`. A keyed
  /// hash, so this table can never be turned back into a list of emails.
  keyHash        String    @id @map("key_hash")
  failedCount    Int       @default(0) @map("failed_count")
  windowStartsAt DateTime  @map("window_starts_at") @db.Timestamptz(3)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sign_in_throttles")
}

/// Who changed what, and when. Append-only: a database trigger (see the
/// migration) rejects every UPDATE and DELETE, so history cannot be rewritten.
/// Owned by the identity module; other modules write through AuditService.
model AuditLog {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  /// Who did it. Null for actions without a signed-in user, such as a lockout.
  actorUserId String? @map("actor_user_id") @db.Uuid
  /// A short dotted name, for example `auth.two_factor_enabled`.
  action     String
  /// What kind of record was affected, for example `user` or `employee`.
  entityType String @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  /// Extra details as JSON. Never personal data — IDs and field names only.
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

/// A client location where guards are posted, for example an office complex.
model Site {
  id         String      @id @default(uuid(7)) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  /// Short code such as ACC-01: three letters for the town, then a number.
  code       String
  name       String
  /// The client company that pays for guarding this site.
  clientName String      @map("client_name")
  region     GhanaRegion
  city       String
  status     SiteStatus  @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]
  posts       Post[]

  @@unique([companyId, code])
  @@map("sites")
}

/// A named guard position at a site, like "Main Gate" or "Reception", with
/// how many guards it needs per shift. Never deleted — set `status` to
/// INACTIVE when the client stops paying for it. Owned by the workforce module.
model Post {
  id             String     @id @default(uuid(7)) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  siteId         String     @map("site_id") @db.Uuid
  name           String
  requiredGuards Int        @default(1) @map("required_guards")
  status         PostStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]

  @@unique([siteId, name])
  @@index([companyId])
  @@map("posts")
}

/// A company-wide working-hours pattern, like "Night Shift 18:00–06:00".
/// Times are minutes from midnight (0–1439); when the end is not after the
/// start, the shift crosses midnight. Owned by the workforce module.
model ShiftPattern {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  /// Minutes from midnight, so 06:00 is 360 and 18:30 is 1110.
  startMinutes Int      @map("start_minutes")
  endMinutes   Int      @map("end_minutes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]

  @@unique([companyId, name])
  @@map("shift_patterns")
}

/// A guard or staff member on the payroll. Employees are never deleted: when
/// someone leaves, `status` becomes TERMINATED so audit and pay history survive.
model Employee {
  id                  String             @id @default(uuid(7)) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  /// Number printed on the ID card, for example SMT-00042.
  staffNumber         String             @map("staff_number")
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  otherNames          String?            @map("other_names")
  /// International format, for example +233241234567.
  phone               String
  email               String?
  /// Ghana Card PIN, for example GHA-123456789-0. It is also the SSNIT number. Sensitive.
  ghanaCardNumber     String             @map("ghana_card_number")
  position            String
  status              EmployeeStatus     @default(PENDING_ENROLLMENT)
  /// When biometrics were enrolled and passed the duplicate check. Empty until
  /// then, and emptied again if the templates are deleted. The workforce module
  /// owns this column; the attendance module updates it through the workforce service.
  biometricEnrolledAt DateTime?          @map("biometric_enrolled_at") @db.Timestamptz(3)
  hireDate            DateTime           @map("hire_date") @db.Date
  terminationDate     DateTime?          @map("termination_date") @db.Date
  terminationReason   TerminationReason? @map("termination_reason")
  terminationNote     String?            @map("termination_note")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]
  user        User?
  periods     EmploymentPeriod[]

  /// One Ghana Card per employee: the first defence against duplicate (ghost) records.
  @@unique([companyId, ghanaCardNumber])
  @@unique([companyId, staffNumber])
  @@index([companyId, status])
  @@map("employees")
}

/// One stretch of employment: from hire to termination. A guard who leaves
/// and later returns keeps the same employee record (their Ghana Card number
/// identifies them), and each stay becomes one row here — that is how rehire
/// history survives. `endsOn = null` means currently employed. Owned by the
/// workforce module.
model EmploymentPeriod {
  id                String             @id @default(uuid(7)) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  startsOn          DateTime           @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  terminationReason TerminationReason? @map("termination_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([employeeId, startsOn])
  @@map("employment_periods")
}

/// Where an employee is posted and for which dates. History is kept: moving a
/// guard ends one assignment and starts a new one. `endsOn = null` means current.
/// `companyId` must match the employee's and the site's company; the workforce
/// service checks this before saving.
model SiteAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  /// The post at the site, when one is set. Null means "at this site, no
  /// particular post" — fine for office staff and new sites.
  postId         String?   @map("post_id") @db.Uuid
  /// The shift pattern worked, when one is set.
  shiftPatternId String?   @map("shift_pattern_id") @db.Uuid
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: Restrict)
  shiftPattern ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([employeeId, endsOn])
  @@index([siteId, endsOn])
  @@map("site_assignments")
}
