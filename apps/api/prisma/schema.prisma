// =============================================================================
// SAMTEC database schema (PostgreSQL, managed with Prisma)
// -----------------------------------------------------------------------------
// This file describes every table. After changing it, run `pnpm db:migrate` to
// create a migration: a SQL file that updates the real database.
// The rules behind these tables live in docs/plan/04-data-model.md.
//
// Naming: TypeScript uses camelCase (firstName). `@map` and `@@map` store the
// same names in snake_case (first_name), the usual PostgreSQL convention, so
// hand-written SQL in later phases stays readable.
//
// Every migration that creates a table must also enable row-level security on
// it (see the end of the first migration and docs/plan/04-data-model.md).
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Where an employee is in their working life. Mirrors `EmployeeStatus` in the API contract.
enum EmployeeStatus {
  PENDING_ENROLLMENT
  ACTIVE
  SUSPENDED
  TERMINATED
}

/// Why an employee left. Mirrors `TerminationReason` in the API contract.
enum TerminationReason {
  RESIGNED
  DISMISSED
  CONTRACT_ENDED
  ABSCONDED
  DECEASED
  OTHER
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

/// ACTIVE means the client pays for this post; INACTIVE keeps it for history.
enum PostStatus {
  ACTIVE
  INACTIVE
}

/// What a user account is allowed to do. Mirrors `UserRole` in the API contract.
enum UserRole {
  ADMIN
  HR_PAYROLL
  SUPERVISOR
  GUARD
}

/// Why a sign-in challenge token was issued (see the `auth_challenges` table).
enum AuthChallengePurpose {
  /// The user typed the right password and must now enter a two-factor code.
  VERIFY_CODE
  /// The user typed the right password and must now set up two-factor authentication.
  SET_UP
  /// An administrator created the account or reset its sign-in; the person
  /// chooses their own password with this one-time link (72 hours).
  SET_PASSWORD
}

/// The 16 administrative regions of Ghana.
enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

/// The security company using SAMTEC. Version 1 has exactly one company, but
/// every business table stores `companyId` so more companies can be added later.
model Company {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees            Employee[]
  sites                Site[]
  assignments          SiteAssignment[]
  users                User[]
  auditLogs            AuditLog[]
  periods              EmploymentPeriod[]
  posts                Post[]
  shiftPatterns        ShiftPattern[]
  devices              Device[]
  punches              PunchEvent[]
  segments             WorkSegment[]
  attendanceExceptions AttendanceException[]
  attendanceCheck      AttendanceCheck?
  biometricConsents    BiometricConsent[]
  biometricCredentials BiometricCredential[]
  biometricExemptions  BiometricExemption[]
  devicePasskeys       DevicePasskey[]
  clockInAttempts      ClockInAttempt[]

  fingerEnrollmentWindows   FingerEnrollmentWindow[]
  terminalEnrollmentReports TerminalEnrollmentReport[]
  detectionRules            DetectionRule[]
  detectionAlerts           DetectionAlert[]
  detectionCheck            DetectionCheck?

  // Phase 4 payroll. The payroll module owns these tables; these are only the
  // other side of their links, which Prisma needs.
  payrollPeriods         PayrollPeriod[]
  payrollRuns            PayrollRun[]
  payrollLines           PayrollLine[]
  payslips               Payslip[]
  taxTables              TaxTable[]
  taxBands               TaxBand[]
  employeePayTerms       EmployeePayTerms[]
  employeePaymentDetails EmployeePaymentDetails[]

  @@map("companies")
}

/// Someone who can sign in to the dashboard. Owned by the identity module.
/// A user may be linked to an employee record (guards and supervisors), or
/// stand alone (office-only accounts).
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// Stored lower-case, so sign-in is not case-sensitive.
  email        String
  /// A scrypt hash. The password itself is never stored (see modules/identity/password.ts).
  /// Empty while the account waits for the person to choose their own
  /// password (after creation or a sign-in reset): such an account cannot sign in.
  passwordHash String?  @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  /// A disabled account cannot sign in, and its refresh tokens stop working.
  isActive     Boolean  @default(true) @map("is_active")
  /// The employee this account belongs to. Required for SUPERVISOR and GUARD
  /// (their data access follows it), always empty for ADMIN and HR_PAYROLL —
  /// a database CHECK enforces both.
  employeeId   String?  @unique @map("employee_id") @db.Uuid

  /// The authenticator-app secret, encrypted with AES-256-GCM (never stored as
  /// plain text). Null until the user finishes two-factor setup.
  twoFactorSecretEncrypted String?   @map("two_factor_secret_encrypted")
  twoFactorEnabledAt       DateTime? @map("two_factor_enabled_at") @db.Timestamptz(3)
  /// The time step of the last accepted code. A code for this step or earlier
  /// is refused, so an overheard code cannot be replayed.
  twoFactorLastUsedStep    BigInt?   @map("two_factor_last_used_step")

  /// Phase 7: an ADMIN account made, promoted, reset or switched back on by one
  /// administrator waits for a second to confirm it, and cannot be used until
  /// then (docs/plan/06, "Two administrators"). All four are empty for every
  /// other role (a database CHECK). A confirmer is never the requester and
  /// never the account itself (another CHECK). Empty `adminConfirmedByUserId`
  /// with a date means nobody else was needed: the company's only
  /// administrator, the setup script, or an account older than the rule.
  adminRequestedByUserId String?   @map("admin_requested_by_user_id") @db.Uuid
  adminRequestedAt       DateTime? @map("admin_requested_at") @db.Timestamptz(3)
  adminConfirmedByUserId String?   @map("admin_confirmed_by_user_id") @db.Uuid
  adminConfirmedAt       DateTime? @map("admin_confirmed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  sessions   UserSession[]
  challenges AuthChallenge[]
  adminRequestedBy User?  @relation("AdminRequestedBy", fields: [adminRequestedByUserId], references: [id], onDelete: Restrict)
  adminConfirmedBy User?  @relation("AdminConfirmedBy", fields: [adminConfirmedByUserId], references: [id], onDelete: Restrict)
  adminsRequested  User[] @relation("AdminRequestedBy")
  adminsConfirmed  User[] @relation("AdminConfirmedBy")

  @@unique([companyId, email])
  @@map("users")
}

/// One signed-in browser: the record behind a refresh token cookie.
/// Owned by the identity module.
///
/// Rotation: every use of a refresh token revokes this row and creates a new
/// one (`replacedById` points forward). If a token arrives for a row that was
/// already replaced, someone copied it, and every session of that user is revoked.
model UserSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the refresh token. The token itself only exists in the cookie.
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// The session that replaced this one when the token was rotated.
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_sessions")
}

/// A half-finished sign-in: the password was right, but a two-factor step is
/// still needed. Owned by the identity module. Rows expire within minutes and
/// are deleted once used.
model AuthChallenge {
  id                     String               @id @default(uuid(7)) @db.Uuid
  userId                 String               @map("user_id") @db.Uuid
  purpose                AuthChallengePurpose
  /// SHA-256 of the challenge or setup token sent to the browser.
  tokenHash              String               @unique @map("token_hash")
  /// For SET_UP: the new authenticator secret (encrypted), moved to the user
  /// only after they prove their app works by entering a correct code.
  pendingSecretEncrypted String?              @map("pending_secret_encrypted")
  /// Wrong codes entered so far. At 5 the challenge is cancelled.
  failedAttempts         Int                  @default(0) @map("failed_attempts")
  expiresAt              DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_challenges")
}

/// Counts failed sign-in steps — wrong passwords per email, wrong two-factor
/// codes per account — so guessing gets locked out. Rows are written with one
/// atomic SQL statement (see SignInThrottleService), so parallel attempts
/// cannot slip past the counter.
model SignInThrottle {
  /// An HMAC (keyed with a key derived from AUTH_SECRET) of what is being
  /// throttled, for example `password:<email>` or `totp:<user id>`. A keyed
  /// hash, so this table can never be turned back into a list of emails.
  keyHash        String    @id @map("key_hash")
  failedCount    Int       @default(0) @map("failed_count")
  windowStartsAt DateTime  @map("window_starts_at") @db.Timestamptz(3)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("sign_in_throttles")
}

/// Who changed what, and when. Append-only: a database trigger (see the
/// migration) rejects every UPDATE and DELETE, so history cannot be rewritten.
/// Owned by the identity module; other modules write through AuditService.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  /// Who did it. Null for actions without a signed-in user, such as a lockout.
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// A short dotted name, for example `auth.two_factor_enabled`.
  action      String
  /// What kind of record was affected, for example `user` or `employee`.
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  /// Extra details as JSON. Never personal data — IDs and field names only.
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

/// A client location where guards are posted, for example an office complex.
model Site {
  id         String      @id @default(uuid(7)) @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  /// Short code such as ACC-01: three letters for the town, then a number.
  code       String
  name       String
  /// The client company that pays for guarding this site.
  clientName String      @map("client_name")
  region     GhanaRegion
  city       String
  status     SiteStatus  @default(ACTIVE)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments          SiteAssignment[]
  posts                Post[]
  devices              Device[]
  punches              PunchEvent[]
  segments             WorkSegment[]
  attendanceExceptions AttendanceException[] @relation("ExceptionSite")
  secondSiteExceptions AttendanceException[] @relation("ExceptionSecondSite")
  detectionAlerts      DetectionAlert[]

  @@unique([companyId, code])
  @@map("sites")
}

/// A named guard position at a site, like "Main Gate" or "Reception", with
/// how many guards it needs per shift. Never deleted — set `status` to
/// INACTIVE when the client stops paying for it. Owned by the workforce module.
model Post {
  id             String     @id @default(uuid(7)) @db.Uuid
  companyId      String     @map("company_id") @db.Uuid
  siteId         String     @map("site_id") @db.Uuid
  name           String
  requiredGuards Int        @default(1) @map("required_guards")
  status         PostStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]

  @@unique([siteId, name])
  @@index([companyId])
  @@map("posts")
}

/// A company-wide working-hours pattern, like "Night Shift 18:00–06:00".
/// Times are minutes from midnight (0–1439); when the end is not after the
/// start, the shift crosses midnight. Owned by the workforce module.
model ShiftPattern {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  /// Minutes from midnight, so 06:00 is 360 and 18:30 is 1110.
  startMinutes Int      @map("start_minutes")
  endMinutes   Int      @map("end_minutes")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments SiteAssignment[]

  @@unique([companyId, name])
  @@map("shift_patterns")
}

/// A guard or staff member on the payroll. Employees are never deleted: when
/// someone leaves, `status` becomes TERMINATED so audit and pay history survive.
model Employee {
  id                  String             @id @default(uuid(7)) @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  /// Number printed on the ID card, for example SMT-00042.
  staffNumber         String             @map("staff_number")
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  otherNames          String?            @map("other_names")
  /// International format, for example +233241234567.
  phone               String
  email               String?
  /// Ghana Card PIN, for example GHA-123456789-0. It is also the SSNIT number. Sensitive.
  ghanaCardNumber     String             @map("ghana_card_number")
  position            String
  status              EmployeeStatus     @default(PENDING_ENROLLMENT)
  /// When biometrics were enrolled and passed the duplicate check. Empty until
  /// then, and emptied again if the templates are deleted. The workforce module
  /// owns this column; the attendance module updates it through the workforce service.
  biometricEnrolledAt DateTime?          @map("biometric_enrolled_at") @db.Timestamptz(3)
  hireDate            DateTime           @map("hire_date") @db.Date
  terminationDate     DateTime?          @map("termination_date") @db.Date
  terminationReason   TerminationReason? @map("termination_reason")
  terminationNote     String?            @map("termination_note")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments               SiteAssignment[]
  user                      User?
  periods                   EmploymentPeriod[]
  punches                   PunchEvent[]
  segments                  WorkSegment[]
  attendanceExceptions      AttendanceException[]
  // Phase 3 biometrics. The attendance module owns these tables; these are
  // only the other side of their links, which Prisma needs.
  biometricConsents         BiometricConsent[]
  biometricCredentials      BiometricCredential[]      @relation("CredentialEmployee")
  lookalikeCredentials      BiometricCredential[]      @relation("CredentialLookalike")
  biometricExemptions       BiometricExemption[]
  devicePasskeys            DevicePasskey[]
  clockInAttempts           ClockInAttempt[]           @relation("AttemptEmployee")
  coSignedAttempts          ClockInAttempt[]           @relation("AttemptCoSignFor")
  fingerEnrollmentWindows   FingerEnrollmentWindow[]
  terminalEnrollmentReports TerminalEnrollmentReport[]
  detectionAlerts           DetectionAlert[]

  // Phase 4 payroll: what this person is paid, and what they were paid.
  payrollLines   PayrollLine[]
  payslips       Payslip[]
  payTerms       EmployeePayTerms[]
  paymentDetails EmployeePaymentDetails?

  /// One Ghana Card per employee: the first defence against duplicate (ghost) records.
  @@unique([companyId, ghanaCardNumber])
  @@unique([companyId, staffNumber])
  @@index([companyId, status])
  @@map("employees")
}

/// One stretch of employment: from hire to termination. A guard who leaves
/// and later returns keeps the same employee record (their Ghana Card number
/// identifies them), and each stay becomes one row here — that is how rehire
/// history survives. `endsOn = null` means currently employed. Owned by the
/// workforce module.
model EmploymentPeriod {
  id                String             @id @default(uuid(7)) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  employeeId        String             @map("employee_id") @db.Uuid
  startsOn          DateTime           @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  terminationReason TerminationReason? @map("termination_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([employeeId, startsOn])
  @@map("employment_periods")
}

/// Where an employee is posted and for which dates. History is kept: moving a
/// guard ends one assignment and starts a new one. `endsOn = null` means current.
/// `companyId` must match the employee's and the site's company; the workforce
/// service checks this before saving.
model SiteAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  siteId         String    @map("site_id") @db.Uuid
  /// The post at the site, when one is set. Null means "at this site, no
  /// particular post" — fine for office staff and new sites.
  postId         String?   @map("post_id") @db.Uuid
  /// The shift pattern worked, when one is set.
  shiftPatternId String?   @map("shift_pattern_id") @db.Uuid
  startsOn       DateTime  @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  post         Post?         @relation(fields: [postId], references: [id], onDelete: Restrict)
  shiftPattern ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([employeeId, endsOn])
  @@index([siteId, endsOn])
  @@map("site_assignments")
}

// =============================================================================
// Attendance (Phase 2). Owned by the attendance module; the rules behind every
// table are in docs/plan/12-attendance-design.md.
// =============================================================================

/// What sends punches. Every kind signs its requests the same way, but each
/// signed route accepts only some kinds (`kindMayUse` in device-signature.ts):
/// a kiosk key can never post raw punches.
enum DeviceKind {
  MOCK
  ZKTECO
  FACE_KIOSK
}

/// INACTIVE refuses every request the device sends. Devices are never deleted.
enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum PunchDirection {
  IN
  OUT
  UNKNOWN
}

/// FACE_PASSKEY (face, then the kiosk's fingerprint sensor) and STAFF_PASSKEY
/// (staff number, then that sensor) are set only by the server for kiosk
/// punches. STAFF_PASSKEY and PIN_FALLBACK are flagged everywhere: neither
/// proves who the worker is.
enum PunchMethod {
  FINGERPRINT
  FACE
  FACE_PASSKEY
  STAFF_PASSKEY
  PIN_FALLBACK
}

enum SegmentBasis {
  BIOMETRIC
  PIN_FALLBACK
  MANUAL
}

/// CONFIRMED counts; DISPUTED overlaps another shift and waits for a person;
/// VOIDED no longer counts (never deleted).
enum SegmentStatus {
  CONFIRMED
  DISPUTED
  VOIDED
}

enum AttendanceExceptionType {
  MISSING_CLOCK_OUT
  MISSING_CLOCK_IN
  UNKNOWN_EMPLOYEE
  INACTIVE_EMPLOYEE
  OVERLAP
  UNEXPECTED_DEVICE_ENROLLMENT
}

enum AttendanceExceptionStatus {
  OPEN
  RESOLVED
  AUTO_CLOSED
}

enum ExceptionResolutionAction {
  DISMISS
  ADD_SEGMENT
  KEEP_SEGMENT
  VOID_ALL
}

/// A clock-in terminal or kiosk, registered by an ADMIN for one site for life.
/// Its secret is stored only encrypted (AES-256-GCM) and signs every request
/// it sends. The rate and failed-signature counters live on this row.
model Device {
  id                    String       @id @default(uuid(7)) @db.Uuid
  companyId             String       @map("company_id") @db.Uuid
  siteId                String       @map("site_id") @db.Uuid
  name                  String
  kind                  DeviceKind
  status                DeviceStatus @default(ACTIVE)
  secretEncrypted       String       @map("secret_encrypted")
  /// Phase 7: a device key can post punches, so one person never issues one
  /// and switches it on. Whoever registered the device or last rotated its
  /// secret is recorded here, and somebody else must switch it on (a database
  /// CHECK, and docs/plan/06, "Two administrators"). Empty on devices made
  /// before the rule and by the seed, which any administrator may switch on.
  keyIssuedByUserId     String?      @map("key_issued_by_user_id") @db.Uuid
  /// Who switched it on. Empty when nobody else was needed: the company had
  /// one administrator, or the device predates the rule.
  activatedByUserId     String?      @map("activated_by_user_id") @db.Uuid
  lastSeenAt            DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  /// The device clock minus the server clock at its last report (positive = fast).
  lastClockDriftSeconds Int?         @map("last_clock_drift_seconds")
  /// Minutes with at least one wrongly signed request (counted once a minute at most).
  failedSignatureCount  Int          @default(0) @map("failed_signature_count")
  lastFailedSignatureAt DateTime?    @map("last_failed_signature_at") @db.Timestamptz(3)
  rateWindowStartsAt    DateTime?    @map("rate_window_starts_at") @db.Timestamptz(3)
  rateWindowCount       Int          @default(0) @map("rate_window_count")
  /// A ZKTeco terminal's serial, typed from its label; its gateway accepts only listed serials.
  serialNumber          String?      @map("serial_number")
  /// Workers may save a finger on this device's own sensor. Kiosks only (a database CHECK);
  /// switching it off must revoke every live key in the same transaction (a trigger refuses it otherwise).
  passkeysEnabled       Boolean      @default(false) @map("passkeys_enabled")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site                      Site                       @relation(fields: [siteId], references: [id], onDelete: Restrict)
  punches                   PunchEvent[]
  consents                  BiometricConsent[]
  credentials               BiometricCredential[]
  passkeys                  DevicePasskey[]
  attempts                  ClockInAttempt[]
  fingerEnrollmentWindows   FingerEnrollmentWindow[]
  terminalEnrollmentReports TerminalEnrollmentReport[]
  detectionAlerts           DetectionAlert[]

  @@unique([companyId, name])
  @@unique([companyId, serialNumber])
  @@index([siteId])
  @@map("devices")
}

/// One punch exactly as a device reported it: the ground truth that pay and
/// ghost detection rest on. Append-only: a database trigger refuses every
/// change and delete, so this table has no `updated_at`.
model PunchEvent {
  id                String         @id @default(uuid(7)) @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  deviceId          String         @map("device_id") @db.Uuid
  /// The device's own ID for the punch. Unique per device: resending is harmless.
  deviceEventId     String         @map("device_event_id")
  /// Copied from the device when the punch arrives.
  siteId            String         @map("site_id") @db.Uuid
  /// Empty when the device user number matched nobody (never paired).
  employeeId        String?        @map("employee_id") @db.Uuid
  deviceUserRef     String         @map("device_user_ref")
  deviceTime        DateTime       @map("device_time") @db.Timestamptz(3)
  serverTime        DateTime       @map("server_time") @db.Timestamptz(3)
  clockDriftSeconds Int?           @map("clock_drift_seconds")
  /// The device clock was more than 5 minutes off, or the time is impossible.
  clockSuspect      Boolean        @default(false) @map("clock_suspect")
  /// False for impossible times (before 2020, or in the future): stored, never paired.
  pairable          Boolean        @default(true)
  direction         PunchDirection
  method            PunchMethod
  /// SHA-256 of the punch's fields in a fixed order: a changed resend is visible.
  payloadHash       String         @map("payload_hash")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device     Device                @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  site       Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employee   Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  clockIns   WorkSegment[]         @relation("ClockIn")
  clockOuts  WorkSegment[]         @relation("ClockOut")
  exceptions AttendanceException[]

  @@unique([deviceId, deviceEventId])
  @@index([employeeId, deviceTime])
  @@index([companyId, deviceTime])
  /// Rule R10: this company's punches that matched nobody, lately.
  @@index([companyId, serverTime], map: "punch_events_orphans")
  @@index([deviceId, deviceTime])
  @@map("punch_events")
}

/// One worked shift: a clock-in paired with its clock-out (or a person's
/// manual correction). Its hours belong to `work_date`, the Ghana date it
/// started. A database exclusion constraint forbids two CONFIRMED segments of
/// one person from overlapping.
model WorkSegment {
  id              String        @id @default(uuid(7)) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  siteId          String        @map("site_id") @db.Uuid
  workDate        DateTime      @map("work_date") @db.Date
  startedAt       DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime      @map("ended_at") @db.Timestamptz(3)
  workedMinutes   Int           @map("worked_minutes")
  basis           SegmentBasis
  status          SegmentStatus @default(CONFIRMED)
  /// Both empty for MANUAL segments, both set otherwise (a database CHECK).
  clockInPunchId  String?       @map("clock_in_punch_id") @db.Uuid
  clockOutPunchId String?       @map("clock_out_punch_id") @db.Uuid
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(3)
  /// Who voided it; empty when re-pairing did. A person's void is never undone.
  voidedByUserId  String?       @map("voided_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  site               Site                  @relation(fields: [siteId], references: [id], onDelete: Restrict)
  clockInPunch       PunchEvent?           @relation("ClockIn", fields: [clockInPunchId], references: [id], onDelete: Restrict)
  clockOutPunch      PunchEvent?           @relation("ClockOut", fields: [clockOutPunchId], references: [id], onDelete: Restrict)
  exceptions         AttendanceException[] @relation("ExceptionSegment")
  secondExceptions   AttendanceException[] @relation("ExceptionSecondSegment")
  resolvedExceptions AttendanceException[] @relation("ExceptionResolutionSegment")

  /// A pair of punches makes at most one row, ever.
  @@unique([clockInPunchId, clockOutPunchId])
  @@index([employeeId, startedAt])
  @@index([companyId, workDate])
  @@index([siteId, workDate])
  @@map("work_segments")
}

/// Something a person must look at. `dedupe_key` (unique per company) makes
/// raising the same exception twice impossible, whoever raises it.
model AttendanceException {
  id                  String                     @id @default(uuid(7)) @db.Uuid
  companyId           String                     @map("company_id") @db.Uuid
  type                AttendanceExceptionType
  status              AttendanceExceptionStatus  @default(OPEN)
  dedupeKey           String                     @map("dedupe_key")
  siteId              String                     @map("site_id") @db.Uuid
  /// For an OVERLAP at two sites, the other site.
  secondSiteId        String?                    @map("second_site_id") @db.Uuid
  employeeId          String?                    @map("employee_id") @db.Uuid
  punchId             String?                    @map("punch_id") @db.Uuid
  segmentId           String?                    @map("segment_id") @db.Uuid
  secondSegmentId     String?                    @map("second_segment_id") @db.Uuid
  occurredAt          DateTime                   @map("occurred_at") @db.Timestamptz(3)
  workDate            DateTime                   @map("work_date") @db.Date
  resolutionAction    ExceptionResolutionAction? @map("resolution_action")
  resolutionNote      String?                    @map("resolution_note")
  resolvedByUserId    String?                    @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?                  @map("resolved_at") @db.Timestamptz(3)
  resolutionSegmentId String?                    @map("resolution_segment_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  company           Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site              Site         @relation("ExceptionSite", fields: [siteId], references: [id], onDelete: Restrict)
  secondSite        Site?        @relation("ExceptionSecondSite", fields: [secondSiteId], references: [id], onDelete: Restrict)
  employee          Employee?    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  punch             PunchEvent?  @relation(fields: [punchId], references: [id], onDelete: Restrict)
  segment           WorkSegment? @relation("ExceptionSegment", fields: [segmentId], references: [id], onDelete: Restrict)
  secondSegment     WorkSegment? @relation("ExceptionSecondSegment", fields: [secondSegmentId], references: [id], onDelete: Restrict)
  resolutionSegment WorkSegment? @relation("ExceptionResolutionSegment", fields: [resolutionSegmentId], references: [id], onDelete: Restrict)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, occurredAt])
  @@index([siteId, status])
  @@index([secondSiteId])
  @@index([employeeId])
  @@map("attendance_exceptions")
}

/// The attendance module's bookmark for time-based checks, one row per
/// company. Every clock-in before `overdueCheckedUntil` has already been
/// looked at for a missing clock-out; each heartbeat moves it forward.
/// `retentionCheckedAt` is when the biometric retention sweep last ran
/// (docs/plan/13 §1); the first heartbeat 24 hours later runs it again.
model AttendanceCheck {
  companyId           String    @id @map("company_id") @db.Uuid
  overdueCheckedUntil DateTime  @map("overdue_checked_until") @db.Timestamptz(3)
  retentionCheckedAt  DateTime? @map("retention_checked_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("attendance_checks")
}

// =============================================================================
// Biometrics (Phase 3). Owned by the attendance module; the rules behind every
// table are in docs/plan/13-biometrics-design.md. The database itself guards
// the important rules (triggers and CHECKs in the migration), so a bug in the
// application can never unblock a duplicate or rewrite history.
// =============================================================================

enum BiometricConsentStatus {
  GIVEN
  WITHDRAWN
}

enum BiometricCredentialKind {
  FACE
  TERMINAL_FINGER
}

/// The duplicate check at enrollment. CLEARED: a collision a second ADMIN let through.
enum DedupeResult {
  PASSED
  COLLISION
  CLEARED
  NOT_CHECKED
}

/// PENDING: a face waiting for a collision review. ACTIVE: a face that PASSED
/// or that a second ADMIN CLEARED (a CHECK), or a terminal finger. BLOCKED (a
/// proven duplicate, or a finger nobody asked for) is final; REVOKED is wiped.
/// Only a live face (PENDING or ACTIVE) holds a template.
enum BiometricCredentialStatus {
  PENDING
  ACTIVE
  BLOCKED
  REVOKED
}

enum CollisionVerdict {
  DIFFERENT_PEOPLE
  SAME_PERSON
}

enum ExemptionStatus {
  REQUESTED
  APPROVED
  REJECTED
  ENDED
}

enum ExemptionReason {
  DECLINED
  CANNOT_ENROLL
  CONSENT_WITHDRAWN
}

enum AttemptPurpose {
  CLOCK
  CO_SIGN
  STAFF_PASSKEY
}

enum AttemptOutcome {
  MATCHED
  AMBIGUOUS
  NOT_RECOGNISED
  LOW_LIVENESS
  FINGERPRINT_REQUESTED
  NOT_ME
  FALLBACK_REFUSED
}

/// A worker's consent to biometrics, or its withdrawal: a new row each time,
/// never changed (a database trigger). It records the exact text shown.
model BiometricConsent {
  id               String                 @id @default(uuid(7)) @db.Uuid
  companyId        String                 @map("company_id") @db.Uuid
  employeeId       String                 @map("employee_id") @db.Uuid
  status           BiometricConsentStatus
  textVersion      String                 @map("text_version")
  /// SHA-256 of the consent text exactly as shown.
  textSha256       String                 @map("text_sha256")
  recordedByUserId String                 @map("recorded_by_user_id") @db.Uuid
  /// The kiosk it was given on; empty for a withdrawal recorded on the dashboard
  /// (a withdrawal may also name one of the company's kiosks).
  deviceId         String?                @map("device_id") @db.Uuid
  /// Set by the database's own clock on insert, whatever the caller sends.
  recordedAt       DateTime               @default(now()) @map("recorded_at") @db.Timestamptz(3)

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device      Device?               @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  credentials BiometricCredential[]

  @@index([employeeId, recordedAt])
  @@map("biometric_consents")
}

/// One enrolled face (its numbers, encrypted, never a photo) or one finger a
/// terminal reported, with its duplicate check and any review of it. Never
/// deleted: a wipe empties the template and keeps the row as evidence.
model BiometricCredential {
  id                  String                    @id @default(uuid(7)) @db.Uuid
  companyId           String                    @map("company_id") @db.Uuid
  employeeId          String                    @map("employee_id") @db.Uuid
  kind                BiometricCredentialKind
  deviceId            String                    @map("device_id") @db.Uuid
  /// AES-256-GCM sealed face template, bound to this row. Empty once wiped, and always for fingers.
  templateSealed      Bytes?                    @map("template_sealed")
  keyVersion          Int?                      @map("key_version") @db.SmallInt
  /// The face model that made the numbers; faces from different models are never compared.
  faceModel           String?                   @map("face_model")
  consentId           String?                   @map("consent_id") @db.Uuid
  enrolledByUserId    String?                   @map("enrolled_by_user_id") @db.Uuid
  dedupe              DedupeResult
  /// Who the face looked like at enrollment, and how closely (0 to 1).
  collisionEmployeeId String?                   @map("collision_employee_id") @db.Uuid
  collisionSimilarity Float?                    @map("collision_similarity") @db.Real
  verdict             CollisionVerdict?
  /// For SAME_PERSON: the record that belongs to the person; the other is blocked.
  keptEmployeeId      String?                   @map("kept_employee_id") @db.Uuid
  resolutionNote      String?                   @map("resolution_note")
  resolvedByUserId    String?                   @map("resolved_by_user_id") @db.Uuid
  resolvedAt          DateTime?                 @map("resolved_at") @db.Timestamptz(3)
  status              BiometricCredentialStatus
  wipedAt             DateTime?                 @map("wiped_at") @db.Timestamptz(3)
  /// Who revoked or withdrew it; empty when the retention sweep or a block wiped it.
  wipedByUserId       String?                   @map("wiped_by_user_id") @db.Uuid
  enrolledAt          DateTime                  @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee        Employee                   @relation("CredentialEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  device          Device                     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  consent         BiometricConsent?          @relation(fields: [consentId], references: [id], onDelete: Restrict)
  lookalike       Employee?                  @relation("CredentialLookalike", fields: [collisionEmployeeId], references: [id], onDelete: Restrict)
  terminalReports TerminalEnrollmentReport[]

  @@index([employeeId])
  @@index([collisionEmployeeId])
  @@index([companyId, dedupe])
  @@map("biometric_credentials")
}

/// A request to let a worker work without biometrics, asked by one ADMIN and
/// decided by another (a database CHECK). It only moves forward (a trigger).
model BiometricExemption {
  id                String          @id @default(uuid(7)) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  employeeId        String          @map("employee_id") @db.Uuid
  status            ExemptionStatus @default(REQUESTED)
  reason            ExemptionReason
  /// Short and factual; supervisors never see it, and the retention sweep clears it.
  note              String?
  requestedByUserId String          @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedByUserId  String?         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewNote        String?         @map("review_note")
  endedAt           DateTime?       @map("ended_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@map("biometric_exemptions")
}

/// A worker's fingerprint key on one kiosk (WebAuthn): only the public half.
/// The finger itself never leaves the device. Never deleted: revoked instead.
model DevicePasskey {
  id                 String    @id @default(uuid(7)) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  deviceId           String    @map("device_id") @db.Uuid
  /// The WebAuthn credential ID (base64url).
  credentialId       String    @map("credential_id")
  publicKey          Bytes     @map("public_key")
  /// The key's signature counter; it may only go up.
  signCount          BigInt    @default(0) @map("sign_count")
  /// The device said it may copy the key to its cloud account (a synced passkey).
  backedUp           Boolean   @map("backed_up")
  registeredByUserId String    @map("registered_by_user_id") @db.Uuid
  registeredAt       DateTime  @default(now()) @map("registered_at") @db.Timestamptz(3)
  lastUsedAt         DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Who revoked it (an ADMIN switching the device's fingerprints off, for example); empty for the retention sweep.
  revokedByUserId    String?   @map("revoked_by_user_id") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([credentialId])
  @@index([employeeId])
  @@index([deviceId])
  @@map("device_passkeys")
}

/// Every face or fingerprint attempt at a kiosk, matched or not. Append-only
/// (a trigger); the retention sweep may only clear the network address. Its
/// ID becomes the punch's `device_event_id`, so a punch finds its attempt
/// without changing it. Scores stay here, on the server.
model ClockInAttempt {
  id                   String         @id @default(uuid(7)) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  deviceId             String         @map("device_id") @db.Uuid
  purpose              AttemptPurpose
  /// IN or OUT only (a database CHECK): the button the worker pressed.
  direction            PunchDirection
  outcome              AttemptOutcome
  /// Who the face (or, for STAFF_PASSKEY, the staff number) matched; the supervisor for CO_SIGN.
  employeeId           String?        @map("employee_id") @db.Uuid
  /// For CO_SIGN: the worker the supervisor confirmed.
  coSignForEmployeeId  String?        @map("co_sign_for_employee_id") @db.Uuid
  /// The staff number typed, for STAFF_PASSKEY and CO_SIGN, even one that matches nobody.
  staffNumberTried     String?        @map("staff_number_tried")
  /// For NOT_ME: the matched attempt it cancelled.
  cancelsAttemptId     String?        @unique @map("cancels_attempt_id") @db.Uuid
  bestScore            Float?         @map("best_score") @db.Real
  runnerUpScore        Float?         @map("runner_up_score") @db.Real
  realScore            Float?         @map("real_score") @db.Real
  liveScore            Float?         @map("live_score") @db.Real
  thresholdVersion     String?        @map("threshold_version")
  /// The WebAuthn challenge when a fingerprint is asked for.
  fingerprintChallenge String?        @map("fingerprint_challenge")
  /// As the hosting platform reports it; cleared by the retention sweep.
  clientAddress        String?        @map("client_address") @db.Inet
  attemptedAt          DateTime       @default(now()) @map("attempted_at") @db.Timestamptz(3)

  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employee    Employee?       @relation("AttemptEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  coSignFor   Employee?       @relation("AttemptCoSignFor", fields: [coSignForEmployeeId], references: [id], onDelete: Restrict)
  cancels     ClockInAttempt? @relation("NotMe", fields: [cancelsAttemptId], references: [id], onDelete: Restrict)
  cancelledBy ClockInAttempt? @relation("NotMe")

  @@index([deviceId, attemptedAt])
  @@index([companyId, attemptedAt])
  @@index([employeeId, attemptedAt])
  @@map("clock_in_attempts")
}

// --- The ZKTeco gateway (Phase 3, docs/plan/13 section 5) --------------------

/// The 30 minutes an ADMIN opens so one worker may enroll a finger on one
/// terminal. A finger reported outside every window is refused: a terminal
/// must never be able to enroll somebody by itself.
model FingerEnrollmentWindow {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  deviceId       String   @map("device_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  openedByUserId String   @map("opened_by_user_id") @db.Uuid
  opensAt        DateTime @default(now()) @map("opens_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device   Device                     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employee Employee                   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reports  TerminalEnrollmentReport[]

  @@index([deviceId, expiresAt])
  @@index([employeeId])
  @@map("finger_enrollment_windows")
}

/// Every finger a terminal reported, accepted or refused. Append-only: it is
/// the record of what each terminal claimed, which is what makes a terminal
/// enrolling somebody by itself visible instead of silent.
model TerminalEnrollmentReport {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  /// The number the terminal used, exactly as it sent it, even one that matches nobody.
  deviceUserRef String   @map("device_user_ref")
  /// Who it matched here, when it matched anybody.
  employeeId    String?  @map("employee_id") @db.Uuid
  /// Which finger the terminal used. For the report only.
  fingerIndex   Int?     @map("finger_index") @db.SmallInt
  /// The terminal's own time, read as UTC.
  enrolledAt    DateTime @map("enrolled_at") @db.Timestamptz(3)
  accepted      Boolean
  /// The credential this created, when it was accepted.
  credentialId  String?  @map("credential_id") @db.Uuid
  /// The window that allowed it, when one did.
  windowId      String?  @map("window_id") @db.Uuid
  reportedAt    DateTime @default(now()) @map("reported_at") @db.Timestamptz(3)

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device     Device                  @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employee   Employee?               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  credential BiometricCredential?    @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  window     FingerEnrollmentWindow? @relation(fields: [windowId], references: [id], onDelete: Restrict)

  @@unique([deviceId, deviceUserRef, enrolledAt])
  @@index([companyId, reportedAt])
  @@map("terminal_enrollment_reports")
}

// --- Ghost detection (Phase 5, docs/plan/08-ghost-detection-engine.md) -------

/// Which rule fired. Mirrors `DetectionRuleCode` in the API contract.
enum DetectionRuleCode {
  R1
  R2
  R3
  R4
  R5
  R6
  R7
  R8
  R9
  R10
  R11
}

/// Mirrors `DetectionSeverity` in the API contract.
enum DetectionSeverity {
  CRITICAL
  HIGH
  MEDIUM
}

/// Mirrors `DetectionAlertStatus` in the API contract.
enum DetectionAlertStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CONFIRMED_FRAUD
}

/// One row per rule, so a threshold can be tuned without a deploy — and so
/// the report's tuning table can be built by moving them.
model DetectionRule {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  code            DetectionRuleCode
  enabled         Boolean           @default(true)
  severity        DetectionSeverity
  /// The numbers this rule uses, named. Empty for a rule that has none.
  thresholds      Json              @default("{}")
  updatedByUserId String?           @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, code])
  @@map("detection_rules")
}

/// A pattern worth a person's attention: who or what it is about, the window
/// it was found in, and the rows the rule cited. Never deleted.
model DetectionAlert {
  id               String               @id @default(uuid(7)) @db.Uuid
  companyId        String               @map("company_id") @db.Uuid
  ruleCode         DetectionRuleCode    @map("rule_code")
  severity         DetectionSeverity
  status           DetectionAlertStatus @default(OPEN)
  /// The rule, the subject and the window. A unique key is what makes a
  /// sweep repeatable: running it twice raises nothing new.
  dedupeKey        String               @map("dedupe_key")
  employeeId       String?              @map("employee_id") @db.Uuid
  deviceId         String?              @map("device_id") @db.Uuid
  siteId           String?              @map("site_id") @db.Uuid
  windowFrom       DateTime             @map("window_from") @db.Date
  windowTo         DateTime             @map("window_to") @db.Date
  /// The IDs and numbers this rule cited. Never a template, an image or a
  /// Ghana Card number.
  evidence         Json
  openedAt         DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolutionNote   String?              @map("resolution_note")
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device   Device?   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  site     Site?     @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([companyId, dedupeKey])
  @@index([companyId, status, openedAt])
  @@index([employeeId])
  @@map("detection_alerts")
}

/// When this company's rules last ran, so a sweep is not repeated needlessly.
model DetectionCheck {
  companyId String   @id @map("company_id") @db.Uuid
  sweptAt   DateTime @map("swept_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("detection_checks")
}

// --- Phase 4 payroll (Samuel). Design: docs/plan/09-payroll-engine-ghana.md ---
// The payroll module owns every table below and nothing else writes to them.
// Money is always an integer number of pesewas, in a column whose name ends in
// "Pesewas". Rates are integer basis points, so 550 means 5.5%.
// Enum values are copied word for word from packages/contracts/openapi.yaml.

enum PayrollPeriodStatus {
  OPEN
  CLOSED
}

/// DRAFT to PENDING_APPROVAL to LOCKED to PAID, and PENDING_APPROVAL to
/// REJECTED, which is terminal. Nothing ever moves backwards (decision 16).
enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  LOCKED
  PAID
  REJECTED
}

/// Why somebody employed during the period has no line on the run. Every one
/// of them is listed, so nobody is silently dropped (decision 7).
enum PayrollRunExclusionReason {
  SUSPENDED
  NO_PAY_TERMS
}

/// One calendar month of pay. It moves OPEN to CLOSED and never back.
model PayrollPeriod {
  id             String              @id @default(uuid(7)) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  year           Int
  /// 1 for January to 12 for December.
  month          Int
  /// The first and last calendar day, so nothing has to re-derive month end.
  startsOn       DateTime            @map("starts_on") @db.Date
  endsOn         DateTime            @map("ends_on") @db.Date
  status         PayrollPeriodStatus @default(OPEN)
  /// Who closed it and when: both empty while OPEN, both set once CLOSED.
  closedAt       DateTime?           @map("closed_at") @db.Timestamptz(3)
  closedByUserId String?             @map("closed_by_user_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  runs    PayrollRun[]

  @@unique([companyId, year, month])
  @@index([companyId, startsOn])
  @@map("payroll_periods")
}

/// A frozen version of the statutory rates. A rate change is a new row, never
/// an edit: a trigger refuses to change one a run has used (decision 12).
model TaxTable {
  id                       String    @id @default(uuid(7)) @db.Uuid
  companyId                String    @map("company_id") @db.Uuid
  taxYear                  Int       @map("tax_year")
  effectiveFrom            DateTime  @map("effective_from") @db.Date
  /// Empty while this is the current version.
  effectiveTo              DateTime? @map("effective_to") @db.Date
  ssnitEmployeeBasisPoints Int       @map("ssnit_employee_basis_points")
  ssnitEmployerBasisPoints Int       @map("ssnit_employer_basis_points")
  ssnitTier1BasisPoints    Int       @map("ssnit_tier1_basis_points")
  ssnitTier2BasisPoints    Int       @map("ssnit_tier2_basis_points")
  /// Where the rates came from. A rate nobody can trace is a rate nobody can defend.
  sourceName               String    @map("source_name")
  sourceUrl                String    @map("source_url")
  sourceCheckedOn          DateTime  @map("source_checked_on") @db.Date
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUserId          String    @map("created_by_user_id") @db.Uuid

  company Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bands   TaxBand[]
  runs    PayrollRun[]
  lines   PayrollLine[]

  @@unique([companyId, effectiveFrom])
  @@index([companyId, taxYear])
  @@map("tax_tables")
}

/// One step of the graduated PAYE table. The last band has no width, because
/// it has no upper limit; a database CHECK insists on exactly that.
model TaxBand {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  taxTableId      String   @map("tax_table_id") @db.Uuid
  /// 1 upwards, the order the bands are filled.
  ordinal         Int
  widthPesewas    Int?     @map("width_pesewas")
  rateBasisPoints Int      @map("rate_basis_points")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  taxTable TaxTable @relation(fields: [taxTableId], references: [id], onDelete: Restrict)

  @@unique([taxTableId, ordinal])
  @@index([companyId])
  @@map("tax_bands")
}

/// What an employee is paid. Effective-dated and never edited: a change is a
/// new row (decision 1). A run reads the row whose effectiveFrom is the latest
/// on or before the period's last day, and copies every value into the line.
model EmployeePayTerms {
  id                         String   @id @default(uuid(7)) @db.Uuid
  companyId                  String   @map("company_id") @db.Uuid
  employeeId                 String   @map("employee_id") @db.Uuid
  effectiveFrom              DateTime @map("effective_from") @db.Date
  basicMonthlyPesewas        Int      @map("basic_monthly_pesewas")
  overtimeHourlyPesewas      Int      @map("overtime_hourly_pesewas")
  taxableAllowancePesewas    Int      @default(0) @map("taxable_allowance_pesewas")
  nonTaxableAllowancePesewas Int      @default(0) @map("non_taxable_allowance_pesewas")
  otherDeductionPesewas      Int      @default(0) @map("other_deduction_pesewas")
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdByUserId            String   @map("created_by_user_id") @db.Uuid

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines    PayrollLine[]

  @@unique([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_pay_terms")
}

/// Where the money is sent. One row per employee, and it IS edited.
/// PERSONAL DATA: never logged, never in an error message, and never on a list
/// a supervisor can read (decision 2). The approval does not cover it, so
/// `updatedAt` is compared with the run's `approvedAt` in the bank export to
/// show a destination that moved afterwards (decision 22).
model EmployeePaymentDetails {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  employeeId      String   @unique @map("employee_id") @db.Uuid
  bankName        String?  @map("bank_name")
  accountName     String?  @map("account_name")
  accountNumber   String?  @map("account_number")
  momoNumber      String?  @map("momo_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@map("employee_payment_details")
}

/// One calculation of one period's pay. Once LOCKED it can never change: a
/// trigger rejects every UPDATE and DELETE on it and on its lines.
model PayrollRun {
  id                 String           @id @default(uuid(7)) @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  periodId           String           @map("period_id") @db.Uuid
  /// The rates version used, frozen the moment this run refers to it.
  taxTableId         String           @map("tax_table_id") @db.Uuid
  status             PayrollRunStatus @default(DRAFT)
  /// The maker: whoever calculated the draft. Never the approver.
  calculatedByUserId String           @map("calculated_by_user_id") @db.Uuid
  calculatedAt       DateTime         @default(now()) @map("calculated_at") @db.Timestamptz(3)
  submittedByUserId  String?          @map("submitted_by_user_id") @db.Uuid
  submittedAt        DateTime?        @map("submitted_at") @db.Timestamptz(3)
  submissionNote     String?          @map("submission_note")
  /// The checker. A database CHECK refuses the submitter (hard rule 3).
  approvedByUserId   String?          @map("approved_by_user_id") @db.Uuid
  approvedAt         DateTime?        @map("approved_at") @db.Timestamptz(3)
  approvalNote       String?          @map("approval_note")
  rejectedByUserId   String?          @map("rejected_by_user_id") @db.Uuid
  rejectedAt         DateTime?        @map("rejected_at") @db.Timestamptz(3)
  rejectionReason    String?          @map("rejection_reason")
  paidByUserId       String?          @map("paid_by_user_id") @db.Uuid
  /// When an ADMIN recorded it here; `paidOn` is the day the money left.
  paidAt             DateTime?        @map("paid_at") @db.Timestamptz(3)
  paidOn             DateTime?        @map("paid_on") @db.Date
  paymentReference   String?          @map("payment_reference")
  paymentNote        String?          @map("payment_note")
  /// Who was employed in the period but has no line, and why. A snapshot,
  /// because the roster moves on: [{ employeeId, staffNumber, fullName, reason }].
  excludedEmployees  Json             @map("excluded_employees")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period   PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  taxTable TaxTable      @relation(fields: [taxTableId], references: [id], onDelete: Restrict)
  lines    PayrollLine[]
  payslips Payslip[]

  @@index([companyId, periodId])
  @@index([companyId, status])
  @@map("payroll_runs")
}

/// One employee's pay for one run, with every input copied in (hard rule 1),
/// so a locked run can be re-checked years later without reading anything
/// else. The totals are always the sums of the parts beside them, and
/// `netPayPesewas` is the difference of them, which a CHECK proves
/// (decision 24).
model PayrollLine {
  id                         String         @id @default(uuid(7)) @db.Uuid
  companyId                  String         @map("company_id") @db.Uuid
  runId                      String         @map("run_id") @db.Uuid
  employeeId                 String         @map("employee_id") @db.Uuid
  /// Copied from the employee, so a locked line reads the same for ever.
  staffNumber                String         @map("staff_number")
  fullName                   String         @map("full_name")
  employeeStatus             EmployeeStatus @map("employee_status")
  /// The pay terms row this line used, and the day it took effect.
  payTermsId                 String         @map("pay_terms_id") @db.Uuid
  payTermsEffectiveFrom      DateTime       @map("pay_terms_effective_from") @db.Date
  /// The rates copied from those terms.
  basicMonthlyPesewas        Int            @map("basic_monthly_pesewas")
  overtimeHourlyPesewas      Int            @map("overtime_hourly_pesewas")
  /// The pro-rating fraction: always calendar facts, never negative.
  daysInPeriod               Int            @map("days_in_period")
  daysEmployed               Int            @map("days_employed")
  /// What the shift patterns scheduled on the days worked, and what was
  /// actually punched. Detection rule R3 compares them from Phase 5 on.
  scheduledMinutes           Int            @map("scheduled_minutes")
  punchedMinutes             Int            @map("punched_minutes")
  regularMinutes             Int            @map("regular_minutes")
  overtimeMinutes            Int            @map("overtime_minutes")
  /// The money. On an adjustment line these are differences and may be negative.
  basicPesewas               Int            @map("basic_pesewas")
  overtimePesewas            Int            @map("overtime_pesewas")
  taxableAllowancePesewas    Int            @map("taxable_allowance_pesewas")
  nonTaxableAllowancePesewas Int            @map("non_taxable_allowance_pesewas")
  grossPesewas               Int            @map("gross_pesewas")
  taxableGrossPesewas        Int            @map("taxable_gross_pesewas")
  ssnitEmployeePesewas       Int            @map("ssnit_employee_pesewas")
  ssnitEmployerPesewas       Int            @map("ssnit_employer_pesewas")
  ssnitTier1Pesewas          Int            @map("ssnit_tier1_pesewas")
  ssnitTier2Pesewas          Int            @map("ssnit_tier2_pesewas")
  chargeableIncomePesewas    Int            @map("chargeable_income_pesewas")
  payePesewas                Int            @map("paye_pesewas")
  otherDeductionsPesewas     Int            @map("other_deductions_pesewas")
  netPayPesewas              Int            @map("net_pay_pesewas")
  /// The rates version used, so this line's arithmetic can be reproduced.
  taxTableId                 String         @map("tax_table_id") @db.Uuid
  taxYear                    Int            @map("tax_year")
  /// An adjustment line corrects a line on an earlier run (decision 20).
  adjustsLineId              String?        @map("adjusts_line_id") @db.Uuid
  adjustmentNote             String?        @map("adjustment_note")
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run         PayrollRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payTerms    EmployeePayTerms @relation(fields: [payTermsId], references: [id], onDelete: Restrict)
  taxTable    TaxTable         @relation(fields: [taxTableId], references: [id], onDelete: Restrict)
  adjustsLine PayrollLine?     @relation("LineAdjustment", fields: [adjustsLineId], references: [id], onDelete: Restrict)
  adjustedBy  PayrollLine[]    @relation("LineAdjustment")
  payslip     Payslip?

  @@index([companyId, runId])
  @@index([employeeId])
  @@map("payroll_lines")
}

/// The payslip PDF, made once inside the transaction that locks the run and
/// stored as bytes, so what was sent is exactly what exists (hard rule 6).
/// Every number on it comes from the line, which can never change afterwards.
model Payslip {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  runId        String   @map("run_id") @db.Uuid
  lineId       String   @unique @map("line_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  pdf          Bytes
  pdfSizeBytes Int      @map("pdf_size_bytes")
  /// SHA-256 of those bytes, so what was sent can be proved to be what exists.
  pdfSha256    String   @map("pdf_sha256")
  generatedAt  DateTime @default(now()) @map("generated_at") @db.Timestamptz(3)

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run      PayrollRun  @relation(fields: [runId], references: [id], onDelete: Restrict)
  line     PayrollLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([companyId, employeeId])
  @@index([runId])
  @@map("payslips")
}
