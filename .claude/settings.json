{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm install)",
      "Bash(pnpm contracts:check)",
      "Bash(pnpm contracts:generate)",
      "Bash(pnpm --filter @samtec/api test:*)",
      "Bash(pnpm --filter @samtec/web test:*)",
      "Bash(pnpm --filter @samtec/api typecheck)",
      "Bash(pnpm --filter @samtec/api db:start)",
      "Bash(pnpm --filter @samtec/api db:seed)",
      "Bash(pnpm --filter @samtec/api db:deploy)",
      "Bash(pnpm --filter @samtec/api db:generate)",
      "Bash(pnpm --filter @samtec/api db:backup:*)",
      "Bash(pnpm --filter @samtec/api load:punches:*)",
      "Bash(pnpm --filter @samtec/api mock:devices:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git ls-files:*)",
      "Bash(git merge-base:*)",
      "Bash(git check-ignore:*)",
      "Bash(git worktree list)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(curl -s https://samtec-test-api.vercel.app/*)",
      "Bash(curl -s -o /dev/null -w * https://samtec-test-api.vercel.app/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.mock)",
      "Read(apps/api/.local-db/**)",
      "Read(**/.samtec/backup-database-url.txt)",
      "Read(**/samtec-backups/*.ndjson)"
    ]
  }
}
